# Pinned toolchain. Every script and CI job reads versions from here.
# Bump a version = update the version AND its checksum in the same commit, then
# record the bump in docs/adr (if it changes behavior) and in CLAUDE.md.

# Godot engine (editor binary; run with --headless for CI/automation — Godot 4
# has no separate server build, the standard binary is the headless build).
GODOT_VERSION=4.7.2
GODOT_FLAVOR=stable
GODOT_ZIP=Godot_v4.7.2-stable_linux.x86_64.zip
GODOT_BIN=Godot_v4.7.2-stable_linux.x86_64
GODOT_URL="https://downloads.godotengine.org/?version=4.7.2&flavor=stable&slug=linux.x86_64.zip"
# SHA-512 of the zip as served by the official godotengine.org download host on
# 2026-10-04 (the official SHA512-SUMS.txt lives on GitHub releases, which was
# unreachable from the build container; see docs/TECH_DEBT.md TD-001).
GODOT_SHA512=9aa00f7a605200940bce3027a567b782f49bd8e940dd06ae9e987bd65aee1b1467edd56ed84fcdcbdd44354bf613bdbb4e5d2913e925850368e150c59ed54c65

# Blender (headless asset generation: blender --background --python ...)
BLENDER_VERSION=5.2.2
BLENDER_TARBALL=blender-5.2.2-linux-x64.tar.xz
BLENDER_DIR=blender-5.2.2-linux-x64
BLENDER_URL=https://download.blender.org/release/Blender5.2/blender-5.2.2-linux-x64.tar.xz
# Verified against the official https://download.blender.org/release/Blender5.2/blender-5.2.2.sha256
BLENDER_SHA256=84098912789dc450e95697c4184fb8a90acbe5111c2ba4aede3fecb57806a168

# GUT (Godot Unit Test) — vendored into game/addons/gut by tools/setup/vendor_gut.py
GUT_VERSION=9.7.1
