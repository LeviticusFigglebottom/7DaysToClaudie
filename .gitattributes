# Normalize text files; keep binaries untouched.
* text=auto eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf

*.png binary
*.jpg binary
*.exr binary
*.glb binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.res binary
*.blend binary
