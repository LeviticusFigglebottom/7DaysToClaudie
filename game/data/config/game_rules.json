{
  "_doc": "World settings for a playthrough (7 Days to Die-style game options). Each option has a type (int/float/bool/enum), range or values, a default and a category; difficulty presets override defaults. A new game resolves: option defaults <- game mode rules (game_modes.json) <- preset <- the player's overrides. The resolved values are saved with the session and read through GameRules.current(). See docs/adr/0014-game-rules-and-gamestage.md.",
  "categories": [
    {"id": "world", "label": "World & time"},
    {"id": "hollowed", "label": "The Hollowed"},
    {"id": "hum", "label": "The Hum"},
    {"id": "factions", "label": "The Ashen"},
    {"id": "loot", "label": "Loot & progression"},
    {"id": "survival", "label": "Survival"},
    {"id": "death", "label": "Death"}
  ],
  "options": {
    "day_length_minutes": {"category": "world", "type": "int", "min": 10, "max": 180, "step": 10, "default": 60, "label": "Day length (real minutes)"},
    "start_season": {"category": "world", "type": "enum", "values": ["spring", "summer", "autumn", "winter"], "default": "autumn", "label": "Starting season"},
    "player_harvest": {"category": "world", "type": "float", "min": 0.5, "max": 3.0, "step": 0.25, "default": 1.0, "label": "Chopping & digging speed"},
    "wildlife": {"category": "world", "type": "bool", "default": true, "label": "Wildlife (deer, hares, birds)"},
    "wildlife_density": {"category": "world", "type": "float", "min": 0.25, "max": 3.0, "step": 0.25, "default": 1.0, "label": "Wildlife density"},
    "murmurs": {"category": "world", "type": "bool", "default": true, "label": "Murmurs (crows that mark you)"},
    "wolves": {"category": "world", "type": "bool", "default": true, "label": "Wolf packs"},
    "gentle_start": {"category": "world", "type": "bool", "default": true, "label": "Gentle first days (no storms or snow before day 4)"},
    "encounter_density": {"category": "world", "type": "float", "min": 0.0, "max": 3.0, "step": 0.25, "default": 1.0, "label": "Forest encounters (camps, wrecks, caches)"},

    "enemy_speed_day": {"category": "hollowed", "type": "enum", "values": ["shamble", "walk", "jog", "run", "sprint"], "default": "walk", "label": "Hollowed speed by day"},
    "enemy_speed_night": {"category": "hollowed", "type": "enum", "values": ["shamble", "walk", "jog", "run", "sprint"], "default": "run", "label": "Hollowed speed at night"},
    "enemy_health": {"category": "hollowed", "type": "float", "min": 0.5, "max": 3.0, "step": 0.25, "default": 1.0, "label": "Hollowed toughness"},
    "enemy_damage": {"category": "hollowed", "type": "float", "min": 0.25, "max": 3.0, "step": 0.25, "default": 1.0, "label": "Hollowed damage to you"},
    "structure_damage": {"category": "hollowed", "type": "float", "min": 0.25, "max": 3.0, "step": 0.25, "default": 1.0, "label": "Hollowed damage to structures"},
    "wanderer_density": {"category": "hollowed", "type": "float", "min": 0.0, "max": 3.0, "step": 0.25, "default": 1.0, "label": "Wanderer density"},
    "sleeper_alertness": {"category": "hollowed", "type": "enum", "values": ["deep", "normal", "light"], "default": "normal", "label": "Sleepers wake"},
    "special_hollowed": {"category": "hollowed", "type": "bool", "default": true, "label": "Special Hollowed (Blister, Husk, Rammer)"},
    "hollowed_hounds": {"category": "hollowed", "type": "bool", "default": true, "label": "Hollowed hound packs"},
    "ashen": {"category": "factions", "type": "bool", "default": true, "label": "The Ashen (scouts and raids)"},
    "ashen_aggression": {"category": "factions", "type": "enum", "values": ["calm", "normal", "fierce"], "default": "normal", "label": "Ashen aggression"},
    "infected_tiers": {"category": "hollowed", "type": "bool", "default": true, "label": "Seeded and Bloomed tiers"},
    "gamestage_days_weight": {"category": "hollowed", "type": "float", "min": 0.0, "max": 4.0, "step": 0.25, "default": 1.5, "label": "Gamestage per day survived"},
    "gamestage_bonus": {"category": "hollowed", "type": "float", "min": 0.5, "max": 2.0, "step": 0.1, "default": 1.0, "label": "Gamestage multiplier"},

    "hum_first_day": {"category": "hum", "type": "int", "min": 1, "max": 28, "step": 1, "default": 7, "label": "First Hum on day"},
    "hum_every_days": {"category": "hum", "type": "int", "min": 0, "max": 28, "step": 1, "default": 7, "label": "Hum every N days (0 = never)"},
    "hum_variance_days": {"category": "hum", "type": "int", "min": 0, "max": 3, "step": 1, "default": 0, "label": "Hum day variance (± days)"},
    "hum_size": {"category": "hum", "type": "float", "min": 0.25, "max": 3.0, "step": 0.25, "default": 1.0, "label": "Hum horde size"},
    "hum_max_alive": {"category": "hum", "type": "int", "min": 8, "max": 64, "step": 4, "default": 24, "label": "Hum Hollowed alive at once"},
    "enemy_speed_hum": {"category": "hum", "type": "enum", "values": ["shamble", "walk", "jog", "run", "sprint"], "default": "sprint", "label": "Hollowed speed during the Hum"},

    "loot_abundance": {"category": "loot", "type": "float", "min": 0.25, "max": 2.0, "step": 0.25, "default": 1.0, "label": "Loot abundance"},
    "loot_respawn_days": {"category": "loot", "type": "int", "min": 0, "max": 60, "step": 5, "default": 0, "label": "Loot respawn (days, 0 = never)"},
    "xp_multiplier": {"category": "loot", "type": "float", "min": 0.25, "max": 3.0, "step": 0.25, "default": 1.0, "label": "XP multiplier"},
    "supply_drops": {"category": "loot", "type": "enum", "values": ["off", "after_hum", "weekly", "every_3_days"], "default": "after_hum", "label": "Remand supply drops"},
    "supply_drop_markers": {"category": "loot", "type": "bool", "default": true, "label": "Mark supply drops on the tether"},

    "needs_rate": {"category": "survival", "type": "float", "min": 0.25, "max": 2.0, "step": 0.25, "default": 1.0, "label": "Hunger & thirst rate"},
    "infection_rate": {"category": "survival", "type": "float", "min": 0.0, "max": 2.0, "step": 0.25, "default": 1.0, "label": "Bloom infection rate"},
    "crop_growth": {"category": "survival", "type": "float", "min": 0.25, "max": 4.0, "step": 0.25, "default": 1.0, "label": "Crop growth speed"},
    "power_fuel_use": {"category": "survival", "type": "float", "min": 0.25, "max": 3.0, "step": 0.25, "default": 1.0, "label": "Generator fuel use"},
    "companion_strength": {"category": "survival", "type": "float", "min": 0.5, "max": 2.0, "step": 0.25, "default": 1.0, "label": "Companion's health and damage"},
    "tutorial": {"category": "survival", "type": "bool", "default": true, "label": "First days tutorial (journal cards, then a distress call)"},
    "trap_damage": {"category": "hollowed", "type": "float", "min": 0.25, "max": 3.0, "step": 0.25, "default": 1.0, "label": "Base trap and sentry damage"},

    "death_penalty": {"category": "death", "type": "enum", "values": ["none", "xp_loss", "drop_pack", "drop_all", "permadeath"], "default": "drop_pack", "label": "On death"}
  },
