   "route": [
    {
     "at": [
      12,
      29
     ],
     "label": "A clearing in the firs: a mossy lych gate in a tumbled churchyard wall, a string of cans across it"
    },
    {
     "at": [
      12,
      25
     ],
     "label": "The chapel front: the doors boarded over by the Cordon, their notice on them, the bell lying in the grass"
    },
    {
     "at": [
      16,
      23
     ],
     "label": "Round the east side through the long grass: a grave dug and left open, jaws in the grass by it"
    },
    {
     "at": [
      15,
      19
     ],
     "label": "A smashed window over a crate, ivy in through the frame"
    },
    {
     "at": [
      13,
      19
     ],
     "label": "Over the sill into the nave: the vigil still sits in the pews"
    },
    {
     "at": [
