   "route": [
    {
     "at": [
      17,
      36
     ],
     "label": "The timber is snapped off at head height in a long swath: the tail of a Cordon transport lies across it, a string of cans across its side door, and the hull beyond with its nose in the bank"
    },
    {
     "at": [
      17,
      24
     ],
     "label": "The debris field: crates burst out of the hold, a medical pallet split open, a wing in the brush, an engine in the dirt, a parachute in the firs"
    },
    {
     "at": [
      16,
      19
     ],
     "label": "The torn end of the fuselage: the cargo ramp gone, its lip at chest height; jaws in the litter under it"
    },
    {
     "at": [
      16,
      15
     ],
     "level": 0,
     "label": "Over the lip into the cargo hold: the medical team's camp on the jump seats and stretchers"
    },
    {
     "at": [
      16,
      7
     ],
     "level": 0,
     "label": "Through the crew bulkhead: the loadmaster's station and his manifest, a ladder up through the flight deck hatch"
    },
    {
     "at": [
      16,
      6
     ],
     "level": 1,
     "label": "Up the ladder onto the flight deck: the pilots still in their seats, the log and the sample key on the console"
    },
    {
     "at": [
      15,
      14
     ],
     "level": 0,
     "label": "Back down and aft to the emergency exit, bolted from inside"
    },
    {
     "at": [
      13,
      14
     ],
     "label": "Draw the bolt and step down into the wreckage beside the hull"
    },
    {
     "at": [
      10,
      34
     ],
     "label": "The tail section's side door, the can string across it"
    },
    {
     "at": [
      10,
      31
     ],
     "level": 0,
     "label": "The tail cabin: the Cordon escort's crates and the sample bay's hatch, deadbolted"
    },
    {
     "at": [
      7,
      31
     ],
     "level": 0,
     "label": "The sample bay: the flight medic with the sample case"
    }
   ],
